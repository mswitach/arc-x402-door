# Seller payout address (receives USDC on Arc Mainnet). Required for 402 accepts.payTo.
PAY_TO=0xYourSellerAddressHere

# Circle Facilitator Service — production settle/verify require auth.
# Prefer a Circle Console API key (Bearer). Keyless trial uses seller proof instead (see README).
CIRCLE_API_KEY=

# Base URL for Circle hosted Facilitator Service x402 routes.
# Confirmed live: GET {FACILITATOR_URL}/supported → 200
FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402

# Arc Mainnet CAIP-2 (eip155:5042). Do not use Base Sepolia for this pack.
NETWORK=arc-mainnet

# Price in USDC (human units). 0.01 → 10000 atomic (6 decimals).
PRICE_USDC=0.01

# Optional: when true, X-Arc-Door-Demo: paid returns the paid JSON shape without live settle
# (for DoraHacks screenshots only — never enable in production).
ALLOW_DEMO_PAID=false

# Optional keyless-trial seller proof (EIP-712). Prefer CIRCLE_API_KEY for production.
# SELLER_PRIVATE_KEY=
