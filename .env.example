# Seller payout address (receives USDC on Arc Mainnet). Required to settle.
# If unset, the door still answers 402 with a placeholder payTo but refuses to settle (503).
PAY_TO=0xYourSellerAddressHere

# Facilitator auth — set exactly ONE of these (Circle returns 400 on mixed auth modes).
# 1) Production: Circle Console API key (Bearer). Mainnet keys start with LIVE_API_KEY:
CIRCLE_API_KEY=
# 2) Keyless trial: private key that controls PAY_TO, used ONLY to sign the
#    Facilitator-Seller-Proof header (EIP-712). Trial allowance per payTo per chain.
#    https://developers.circle.com/facilitator-service/keyless-trial
# SELLER_PRIVATE_KEY=

# Circle hosted Facilitator Service x402 base (GET {FACILITATOR_URL}/supported is public).
FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402

# Arc Mainnet → CAIP-2 eip155:5042.
NETWORK=arc-mainnet

# Price in USDC (human units, max 6 decimals). 0.01 → 10000 atomic.
PRICE_USDC=0.01

# Demo only: when true, X-Arc-Door-Demo: paid (or ?demo=paid) returns the paid JSON shape
# without any settle. Must be false for the real smoke.
ALLOW_DEMO_PAID=false

# Rehearsal switch: run /verify but never /settle.
SETTLE_DISABLED=false
